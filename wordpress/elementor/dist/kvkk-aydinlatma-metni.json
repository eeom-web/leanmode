ition:absolute;inset:4% 0;z-index:-1;border-radius:50%;background:radial-gradient(closest-side,#dce8e0 0%,rgba(220,232,224,.55) 55%,rgba(220,232,224,0) 100%)} .lmp-book{position:relative;width:var(--book-w);aspect-ratio:2/3;container-type:inline-size;filter:drop-shadow(0 30px 40px rgba(15,29,25,.22)) drop-shadow(0 6px 10px rgba(15,29,25,.12))} .lmp-book__pages{position:absolute;inset:1.6% -3.2% 1.6% 4%;border-radius:3px 8px 8px 3px;background:linear-gradient(90deg,rgba(0,0,0,.08),transparent 30%),repeating-linear-gradient(90deg,#fbfaf6 0 1.5px,#e2e1d9 1.5px 2.5px)} .lmp-book__cover{position:absolute;inset:0;border-radius:4px 10px 10px 4px;overflow:hidden;background:#101614} .lmp-book__cover img{display:block;width:100%;height:100%;object-fit:cover} .lmp-book__cover::before{content:\"\";position:absolute;inset:0 auto 0 0;z-index:1;width:5cqi;background:linear-gradient(90deg,rgba(0,0,0,.32) 0%,rgba(255,255,255,.1) 55%,rgba(0,0,0,.12) 100%)} .lmp-daycard{position:absolute;bottom:10%;right:max(0px,calc(50% - var(--book-w)/2 - 3rem));display:grid;gap:8px;width:200px;padding:14px 16px;border:1px solid #E3E2DB;border-radius:16px;background:#fff;box-shadow:0 2px 6px rgba(16,22,20,.04),0 30px 70px -28px rgba(16,22,20,.28);line-height:1.3} .lmp-daycard__head{display:flex;align-items:center;gap:8px;color:#5D6762;font-size:12px;font-weight:600;letter-spacing:.1em} .lmp-daycard__head svg{color:#1D5A48} .lmp-daycard__head strong{color:#101614} .lmp-daycard__bar{display:grid;grid-template-columns:repeat(30,1fr);gap:2px} .lmp-daycard__bar i{height:6px;border-radius:2px;background:#EFEEE8} .lmp-daycard__bar i.is-done{background:#1D5A48} .lmp-daycard__text{color:#101614;font-size:14px;font-weight:600} @media (max-width:479px){.lmp-daycard{width:176px;padding:12px 14px}} /* Phones: hero title and cover side by side above the signup card (first screen without scrolling) */ @media (max-width:767px){ .elementor .e-con .lmp-hero-title .elementor-heading-title{font-size:clamp(22px,7vw,30px);line-height:1.12} .lmp-hero-visual .lmp-mockup{--book-w:min(33vw,160px);padding:4px 4px 8px} .lmp-hero-visual .lmp-daycard{display:none} #kayit .lmp-signup__label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap} }</style>\n<script>(function(){\n  /* Formular-Einstellungen.\n     brevoFormUrl: öffentliche Adresse des Brevo-Anmeldeformulars (action aus dem Brevo-Einbettungscode).\n     Das ist kein Geheimnis und kein API-Schlüssel. Leer = Demo-Modus, es wird nichts gesendet.\n     Double-Opt-in, Liste, Bestätigungs-Mail und die Weiterleitung nach der Bestätigung stellt Brevo im Formular ein. */\n  var CONFIG = {\n    brevoFormUrl: 'https://7c905345.sibforms.com/serve/MUIFADIq3Y7ilkUefu0VUgSDY6zbPkBfj1elhcMDMOW47P1yy0u4b310TIrfOyMpe89fyMLw3rLnEwhF2hQJAGQs0x4USC_ByNsT-UM0mH4jdE_S96lJ4Dr3tAYm7mgz82PEsY4OzdXCtgqY7hORkFuVqZ_hq_6XiqOk-wvvGNgIdBWDv8oxlcw62jvp1NFSy0tzL4FV3hZHzKfRMA==',\n    brevoLocale: 'de',\n    successUrl: '/tesekkurler/',\n    timeoutMs: 15000\n  };\n  var TEXT = {\n    empty: 'Lütfen e-posta adresini gir.',\n    invalid: 'Lütfen geçerli bir e-posta adresi gir.',\n    failed: 'Şu anda kaydını alamadık. Lütfen birazdan tekrar dene.',\n    loading: 'Gönderiliyor…'\n  };\n  var EMAIL = /^[^\\s@]+@[^\\s@.]+(?:\\.[^\\s@.]+)*\\.[^\\s@.]{2,}$/;\n  function isValid(v){ return v.length <= 254 && EMAIL.test(v); }\n\n  function setError(form, input, msg){\n    var el = form.querySelector('[data-error]');\n    if (el) el.textContent = msg;\n    input.setAttribute('aria-invalid', msg ? 'true' : 'false');\n  }\n  function setLoading(form, on){\n    var btn = form.querySelector('button[type=submit]');\n    var label = btn && btn.querySelector('[data-label]');\n    if (!btn || !label) return;\n    if (!btn.dataset.idle) btn.dataset.idle = label.textContent;\n    btn.disabled = on;\n    form.setAttribute('aria-busy', on ? 'true' : 'false');\n    label.textContent = on ? TEXT.loading : btn.dataset.idle;\n  }\n  function showSuccess(form){\n    if (CONFIG.successUrl) { window.location.assign(CONFIG.successUrl); return; }\n    var root = form.closest('[data-lmp-root]');\n    var ok = root && root.querySelector('[data-success]');\n    if (!ok) return;\n    form.hidden = true; ok.hidden = false; ok.focus({ preventScroll: true });\n  }\n  /* Sends the address the same way Brevo's own embed script does: multipart POST to <form url>?isAjax=1,\n     answer is JSON with success: true/false. No cookies are sent along. */\n  function send(payload){\n    if (!CONFIG.brevoFormUrl) {\n      console.info('[Lean Mode Pro] Demo-Modus: kein Formular verbunden, es wurde nichts gesendet.', payload);\n      return new Promise(function(r){ setTimeout(r, 600); });\n    }\n    var body = new FormData();\n    body.append('EMAIL', payload.email);\n    body.append('email_address_check', '');\n    body.append('locale', CONFIG.brevoLocale);\n    var ctrl = new AbortController();\n    var t = setTimeout(function(){ ctrl.abort(); }, CONFIG.timeoutMs);\n    return fetch(CONFIG.brevoFormUrl + '?isAjax=1', { method: 'POST', body: body, credentials: 'omit', signal: ctrl.signal })\n      .then(function(res){\n        clearTimeout(t);\n        return res.json().catch(function(){ return {}; }).then(function(data){\n          if (!res.ok || !data.success) throw new Error('Brevo ' + res.status + ' ' + JSON.stringify(data.errors || data.message || ''));\n        });\n      }, function(err){ clearTimeout(t); throw err; });\n  }\n  /* Cookie banner + Meta Pixel. The pixel loads only after \"Kabul et\"; the choice is kept in the\n     necessary cookie lmp_consent (12 months). \"Çerez ayarları\" in the footer (#cerez-ayarlari) reopens it. */\n  var PIXEL_ID = '2362284981222890';\n  var CONSENT = {\n    cookie: 'lmp_consent', maxAge: 31536000,\n    title: 'Çerez tercihin',\n    text: 'Onay verirsen, reklamlarımızın etkisini ölçmek ve Facebook ile Instagram\\'da sana uygun reklamlar gösterebilmek için Meta Pixel\\'i kullanırız. Bunun için çerezler kullanılır ve veriler Meta\\'ya (ABD dahil) aktarılır. Onay vermesen de site eksiksiz çalışır. Seçimini istediğin zaman sayfanın altındaki “Çerez ayarları” bağlantısından değiştirebilirsin.',\n    links: '<a href=\"/cerez-politikasi/\">Çerez Politikası</a> · <a href=\"/gizlilik-politikasi/\">Gizlilik Politikası</a> · <a href=\"/kvkk-aydinlatma-metni/\">KVKK Aydınlatma Metni</a>',\n    deny: 'Reddet', accept: 'Kabul et'\n  };\n  function getConsent(){\n    var m = document.cookie.match(/(?:^|; )lmp_consent=(granted|denied)/);\n    return m ? m[1] : null;\n  }\n  function setConsent(value){\n    document.cookie = CONSENT.cookie + '=' + value + '; Max-Age=' + CONSENT.maxAge + '; Path=/; SameSite=Lax' +\n      (location.protocol === 'https:' ? '; Secure' : '');\n  }\n  function loadPixel(){\n    if (!PIXEL_ID || window.fbq) return;\n    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;\n    n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];\n    s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');\n    window.fbq('init', PIXEL_ID);\n    window.fbq('track', 'PageView');\n  }\n  function clearMetaCookies(){\n    var host = location.hostname.replace(/^www\\./, '');\n    ['_fbp', '_fbc'].forEach(function(name){\n      ['', '; Domain=' + host, '; Domain=.' + host].forEach(function(domain){\n        document.cookie = name + '=; Max-Age=0; Path=/' + domain;\n      });\n    });\n  }\n  function closeBanner(){\n    var el = document.getElementById('lmp-consent');\n    if (el) el.parentNode.removeChild(el);\n  }\n  function decide(value){\n    setConsent(value);\n    closeBanner();\n    if (value === 'granted') { loadPixel(); return; }\n    if (window.fbq) window.fbq('consent', 'revoke');\n    clearMetaCookies();\n  }\n  function showBanner(){\n    if (document.getElementById('lmp-consent')) return;\n    var el = document.createElement('div');\n    el.id = 'lmp-consent';\n    el.className = 'lmp-consent';\n    el.setAttribute('role', 'dialog');\n    el.setAttribute('aria-labelledby', 'lmp-consent-title');\n    el.innerHTML = '<p class=\"lmp-consent__title\" id=\"lmp-consent-title\">' + CONSENT.title + '</p>' +\n      '<p class=\"lmp-consent__text\">' + CONSENT.text + ' ' + CONSENT.links + '</p>' +\n      '<div class=\"lmp-consent__actions\">' +\n      '<button type=\"button\" class=\"lmp-consent__btn\" data-consent=\"denied\">' + CONSENT.deny + '</button>' +\n      '<button type=\"button\" class=\"lmp-consent__btn\" data-consent=\"granted\">' + CONSENT.accept + '</button></div>';\n    el.addEventListener('click', function(e){\n      var btn = e.target.closest('[data-consent]');\n      if (btn) decide(btn.getAttribute('data-consent'));\n    });\n    document.body.appendChild(el);\n  }\n  function initConsent(){\n    var choice = getConsent();\n    if (choice === 'granted') loadPixel();\n    else if (!choice) showBanner();\n    document.addEventListener('click', function(e){\n      var link = e.target.closest && e.target.closest('a[href$=\"#cerez-ayarlari\"]');\n      if (!link) return;\n      e.preventDefault();\n      showBanner();\n      var first = document.querySelector('#lmp-consent [data-consent]');\n      if (first) first.focus({ preventScroll: true });\n    });\n  }\n\n  function init(){\n    initConsent();\n    var header = document.querySelector('.lmp-header');\n    if (header) {\n      var upd = function(){ header.classList.toggle('is-scrolled', window.scrollY > 8); };\n      upd(); window.addEventListener('scroll', upd, { passive: true });\n    }\n    document.querySelectorAll('form[data-lmp-signup]').forEach(function(form){\n      var input = form.querySelector('input[name=email]');\n      input.addEventListener('input', function(){\n        if (input.getAttribute('aria-invalid') === 'true' && isValid(input.value.trim())) setError(form, input, '');\n      });\n      form.addEventListener('submit', function(e){\n        e.preventDefault();\n        if (form.getAttribute('aria-busy') === 'true') return;\n        var email = input.value.trim();\n        var hp = form.querySelector('input[name=website]');\n        if (hp && hp.value) { showSuccess(form); return; }\n        if (!email || !isValid(email)) {\n          setError(form, input, email ? TEXT.invalid : TEXT.empty);\n          input.focus(); return;\n        }\n        setError(form, input, '');\n        setLoading(form, true);\n        var source = (form.querySelector('input[name=source]') || {}).value || 'unknown';\n        send({ email: email, source: source })\n          .then(function(){ setLoading(form, false); showSuccess(form); })\n          .catch(function(err){ console.error(err); setLoading(form, false); setError(form, input, TEXT.failed); });\n      });\n    });\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();\n})();</script>","_css_classes":"lmp-assets"},"elements":[]},{"id":"151e84b","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_wrap":"nowrap","flex_gap":{"column":"16","row":"16","isLinked":true,"unit":"px"},"flex_align_items":"center","flex_justify_content":"space-between"},"elements":[{"id":"8e5cf7b","elType":"widget","widgetType":"heading","settings":{"title":"LEAN MODE <span class=\"lmp-pro\">PRO</span>","header_size":"p","link":{"url":"/","is_external":"","nofollow":"","custom_attributes":""},"title_color":"#101614","_css_classes":"lmp-logo","__globals__":{"title_color":"globals/colors?id=lmpink"},"typography_typography":"custom","typography_font_family":"Instrument Sans","typography_font_size":{"unit":"px","size":15,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":14,"sizes":[]},"typography_font_weight":"700","typography_line_height":{"unit":"em","size":1,"sizes":[]},"typography_letter_spacing":{"unit":"em","size":0.14,"sizes":[]},"typography_letter_spacing_mobile":{"unit":"em","size":0.1,"sizes":[]}},"elements":[]},{"id":"b8716a6","elType":"widget","widgetType":"button","settings":{"text":"Ücretsiz Rehberi Al","link":{"url":"/#kayit","is_external":"","nofollow":"","custom_attributes":""},"size":"sm","selected_icon":{"value":"fas fa-arrow-right","library":"fa-solid"},"icon_align":"row-reverse","icon_indent":{"unit":"px","size":8,"sizes":[]},"button_text_color":"#FFFFFF","background_background":"classic","background_color":"#1D5A48","button_background_hover_background":"classic","button_background_hover_color":"#164A3B","hover_color":"#FFFFFF","border_radius":{"unit":"px","top":"999","right":"999","bottom":"999","left":"999","isLinked":true},"text_padding":{"unit":"px","top":"10","right":"18","bottom":"10","left":"18","isLinked":false},"button_box_shadow_box_shadow_type":"yes","button_box_shadow_box_shadow":{"horizontal":0,"vertical":1,"blur":2,"spread":0,"color":"rgba(16,22,20,0.12)"},"button_hover_transition_duration":{"unit":"s","size":0.2,"sizes":[]},"typography_typography":"custom","typography_font_family":"Instrument Sans","typography_font_size":{"unit":"px","size":14,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.2,"sizes":[]},"text_padding_mobile":{"unit":"px","top":"10","right":"14","bottom":"10","left":"14","isLinked":false},"_css_classes":"lmp-header-cta","__globals__":{"background_color":"globals/colors?id=lmpink","button_background_hover_color":"globals/colors?id=lmpinksoft"}},"elements":[]}],"isInner":true}],"isInner":false},{"id":"a9dffd5","elType":"container","settings":{"content_width":"boxed","flex_direction":"column","boxed_width":{"unit":"px","size":760,"sizes":[]},"flex_gap":{"column":"24","row":"24","isLinked":true,"unit":"px"},"html_tag":"section","padding":{"unit":"px","top":"96","right":"32","bottom":"96","left":"32","isLinked":false},"padding_tablet":{"unit":"px","top":"72","right":"32","bottom":"72","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"16","bottom":"56","left":"16","isLinked":false},"min_height":{"unit":"vh","size":60,"sizes":[]},"css_classes":"e-no-lazyload"},"elements":[{"id":"938ffd3","elType":"widget","widgetType":"heading","settings":{"title":"<a href=\"/\">← Ana sayfaya dön</a>","header_size":"p","title_color":"#101614","__globals__":{"title_color":"globals/colors?id=lmpmuted","typography_typography":"globals/typography?id=lmpsmall"}},"elements":[]},{"id":"f8d40b0","elType":"widget","widgetType":"heading","settings":{"title":"KVKK Aydınlatma Metni","header_size":"h1","title_color":"#101614","__globals__":{"title_color":"globals/colors?id=lmpink"},"typography_typography":"custom","typography_font_family":"Instrument Sans","typography_font_size":{"unit":"px","size":52,"sizes":[]},"typography_font_size_tablet":{"unit":"px","size":42,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":34,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.08,"sizes":[]},"typography_letter_spacing":{"unit":"em","size":-0.026,"sizes":[]}},"elements":[]},{"id":"2ab7756","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>6698 sayılı Kişisel Verilerin Korunması Kanunu'nun (KVKK) 10. maddesi ve Aydınlatma Yükümlülüğünün Yerine Getirilmesinde Uyulacak Usul ve Esaslar Hakkında Tebliğ uyarınca, Türkiye'de bulunan ziyaretçilerimizi ve kayıt olan kullanıcılarımızı kişisel verilerinin işlenmesi hakkında bilgilendiriyoruz. Bu metin yalnızca bilgilendirme amaçlıdır ve herhangi bir onay gerektirmez.</p><p>Avrupa Birliği Genel Veri Koruma Tüzüğü (GDPR) kapsamındaki ayrıntılı bilgileri <a href=\"/gizlilik-politikasi/\">Gizlilik Politikası</a>'nda, kullanılan çerezleri <a href=\"/cerez-politikasi/\">Çerez Politikası</a>'nda bulabilirsin.</p><h2>1. Veri sorumlusu</h2><p>Kişisel verilerin, veri sorumlusu sıfatıyla aşağıdaki kişi tarafından işlenir:</p><p>{{lmp:name}}<br>{{lmp:street}}<br>{{lmp:city}}<br>Almanya</p><p>E-posta: <a href=\"mailto:{{lmp:email}}\">{{lmp:email}}</a><!--lmp:phone--><br>Telefon: {{lmp:phone}}<!--/lmp:phone--></p><p>Veri sorumlusu Almanya'da yerleşiktir.</p><!--lmp:kvkkrep--><p>Türkiye'deki veri sorumlusu temsilcimiz: {{lmp:kvkkrep}}</p><!--/lmp:kvkkrep--><h2>2. İşlenen kişisel veriler, işleme amaçları ve hukuki sebepler</h2><p>Kişisel verilerini yalnızca aşağıda belirtilen amaçlarla ve KVKK'nın 5. maddesinde sayılan hukuki sebeplere dayanarak işleriz. Sağlık verileri gibi özel nitelikli kişisel verileri (KVKK md. 6) istemiyor ve işlemiyoruz; kayıt formunda yalnızca e-posta adresin istenir.</p><h3>Siteyi ziyaret ettiğinde</h3><ul><li><strong>Veriler:</strong> İşlem güvenliği verileri: IP adresi, tarih ve saat, açılan sayfa veya dosya, daha önce ziyaret edilen sayfa, tarayıcı ve işletim sistemi bilgisi</li><li><strong>Amaç:</strong> Siteyi sunmak, bilgi güvenliğini sağlamak, hataları ve saldırıları tespit etmek</li><li><strong>Hukuki sebep:</strong> Temel hak ve özgürlüklerine zarar vermemek kaydıyla veri sorumlusunun meşru menfaati (KVKK md. 5/2-f)</li><li><strong>Toplama yöntemi:</strong> Siteyi açtığında tarayıcın tarafından otomatik olarak gönderilir ve sunucu kayıtlarına yazılır</li></ul><h3>Ücretsiz plan için kayıt olduğunda</h3><ul><li><strong>Veriler:</strong> İletişim verisi: e-posta adresi; işlem güvenliği verileri: kayıt ve onay zamanı, bu sırada kullanılan IP adresi</li><li><strong>Amaç:</strong> E-posta adresini doğrulamak (çift onay) ve talep ettiğin ücretsiz planı sana sunmak</li><li><strong>Hukuki sebep:</strong> Bir sözleşmenin kurulması veya ifasıyla doğrudan ilgili olması (KVKK md. 5/2-c)</li><li><strong>Toplama yöntemi:</strong> Sitedeki kayıt formu ve onay e-postasındaki bağlantı aracılığıyla elektronik ortamda</li></ul><h3>E-posta bülteni ve teklifler</h3><ul><li><strong>Veriler:</strong> İletişim verisi: e-posta adresi</li><li><strong>Amaç:</strong> LEAN MODE PRO'nun faydalı içeriklerini ve tekliflerini e-postayla göndermek</li><li><strong>Hukuki sebep:</strong> Açık rızan (KVKK md. 5/1) ve 6563 sayılı Elektronik Ticaretin Düzenlenmesi Hakkında Kanun kapsamında verdiğin ticari elektronik ileti onayı</li><li><strong>Toplama yöntemi:</strong> Sitedeki kayıt formu aracılığıyla elektronik ortamda</li></ul><h3>E-postaların açılma ve tıklanma ölçümü</h3><ul><li><strong>Veriler:</strong> Pazarlama verileri: bir e-postanın açılıp açılmadığı, içindeki hangi bağlantılara tıklandığı, bunların zamanı, IP adresi, e-posta programı ve cihaz hakkında teknik bilgiler</li><li><strong>Amaç:</strong> E-postalarımızın ne kadar ilgi gördüğünü ölçmek ve içeriklerimizi iyileştirmek</li><li><strong>Hukuki sebep:</strong> Veri sorumlusunun meşru menfaati (KVKK md. 5/2-f); abonelikten çıktığında ölçüm de sona erer</li><li><strong>Toplama yöntemi:</strong> E-postalardaki küçük, görünmez bir görsel (izleme pikseli) ve Brevo üzerinden yönlendirilen bağlantılar aracılığıyla otomatik olarak</li></ul><!--lmp:meta--><h3>Meta Pixel (Facebook ve Instagram reklamları)</h3><ul><li><strong>Veriler:</strong> Pazarlama ve işlem güvenliği verileri: çerez kimlikleri (<code>_fbp</code>, <code>_fbc</code>), ziyaret edilen sayfalar, sayfa görüntüleme gibi olaylar ve etkileşimler, IP adresi, tarayıcı ve cihaz bilgileri, reklam tıklama kimliği</li><li><strong>Amaç:</strong> Facebook ve Instagram reklamlarımızın etkisini ölçmek, siteyi ziyaret etmiş kişilere bu platformlarda reklam göstermek ve reklamlarımızı iyileştirmek</li><li><strong>Hukuki sebep:</strong> Açık rızan (KVKK md. 5/1); çerez penceresinde <strong>Kabul et</strong>'e tıklamadıkça Meta Pixel yüklenmez</li><li><strong>Toplama yöntemi:</strong> Çerezler ve benzeri teknolojiler aracılığıyla otomatik olarak</li></ul><!--/lmp:meta--><!--lmp:ga--><h3>Google Analytics</h3><ul><li><strong>Veriler:</strong> Ziyaret edilen sayfalar ve süreleri, siteye nereden gelindiği, cihaz, tarayıcı ve işletim sistemi, yaklaşık konum, etkileşimler, çerez kimlikleri</li><li><strong>Amaç:</strong> Sitenin nasıl kullanıldığını istatistiksel olarak anlamak ve siteyi geliştirmek</li><li><strong>Hukuki sebep:</strong> Açık rızan (KVKK md. 5/1)</li><li><strong>Toplama yöntemi:</strong> Çerezler aracılığıyla otomatik olarak</li></ul><!--/lmp:ga--><!--lmp:gads--><h3>Google Ads</h3><ul><li><strong>Veriler:</strong> Çerez kimlikleri, reklam tıklamaları, ziyaret edilen sayfalar ve kayıt gibi dönüşümler</li><li><strong>Amaç:</strong> Google reklamlarımızın etkisini ölçmek ve siteyi ziyaret etmiş kişilere yeniden reklam göstermek</li><li><strong>Hukuki sebep:</strong> Açık rızan (KVKK md. 5/1)</li><li><strong>Toplama yöntemi:</strong> Çerezler aracılığıyla otomatik olarak</li></ul><!--/lmp:gads--><!--lmp:tracking--><h3>Çerez tercihin</h3><ul><li><strong>Veriler:</strong> Çerez penceresindeki seçimin (kabul veya ret)</li><li><strong>Amaç:</strong> Seçimini hatırlamak ve onay verip vermediğini ispat edebilmek</li><li><strong>Hukuki sebep:</strong> Veri sorumlusunun hukuki yükümlülüğünü yerine getirebilmesi için zorunlu olması (KVKK md. 5/2-ç) ve meşru menfaat (KVKK md. 5/2-f)</li><li><strong>Toplama yöntemi:</strong> Tarayıcında saklanan zorunlu bir çerez (<code>lmp_consent</code>) aracılığıyla</li></ul><!--/lmp:tracking--><h3>Onay kayıtları</h3><ul><li><strong>Veriler:</strong> Hukuki işlem verileri: kayıt ve onay zamanı, bu sırada kullanılan IP adresi, kullanılan kayıt formu, abonelikten çıkma zamanı</li><li><strong>Amaç:</strong> Ticari elektronik ileti onayını ispat etmek ve olası uyuşmazlıklarda haklarımızı korumak</li><li><strong>Hukuki sebep:</strong> Kanunlarda açıkça öngörülmesi ve hukuki yükümlülük (KVKK md. 5/2-a ve 5/2-ç; 6563 sayılı Kanun ve Ticari İletişim ve Ticari Elektronik İletiler Hakkında Yönetmelik) ile bir hakkın tesisi, kullanılması veya korunması (KVKK md. 5/2-e)</li><li><strong>Toplama yöntemi:</strong> Kayıt, onay ve abonelikten çıkma sırasında otomatik olarak</li></ul><h3>Bize e-posta yazdığında</h3><ul><li><strong>Veriler:</strong> Kimlik ve iletişim verileri: adın, e-posta adresin ve mesajında paylaştığın bilgiler</li><li><strong>Amaç:</strong> Talebini veya başvurunu yanıtlamak</li><li><strong>Hukuki sebep:</strong> Veri sorumlusunun meşru menfaati (KVKK md. 5/2-f); KVKK kapsamındaki başvurularda hukuki yükümlülük (KVKK md. 5/2-ç)</li><li><strong>Toplama yöntemi:</strong> E-posta yoluyla</li></ul><h2>3. Kişisel verilerin aktarılması</h2><p>Kişisel verilerini satmıyoruz. Verilerini yalnızca yukarıdaki amaçlar için gerekli olduğu ölçüde şu alıcılara aktarırız:</p><ul><li><strong>Barındırma hizmeti sağlayıcısı:</strong> Hostinger International Ltd., Kıbrıs (sunucu: Frankfurt, Almanya). Amaç: sitenin barındırılması. Veri işleyen olarak, yalnızca talimatlarımız doğrultusunda.</li><li><strong>E-posta hizmeti sağlayıcısı:</strong> Sendinblue SAS (Brevo), Paris, Fransa. Amaç: kayıt formu, onay e-postası, bülten gönderimi ve ölçüm. Veri işleyen olarak, yalnızca talimatlarımız doğrultusunda.</li><!--lmp:meta--><li><strong>Meta:</strong> Meta Platforms Ireland Limited, Merrion Road, Dublin 4, D04 X2K5, İrlanda; ana şirketi Meta Platforms, Inc., ABD. Amaç: reklam ölçümü ve reklamların hedeflenmesi, yalnızca açık rızanla. Verilerin sitemizde toplanması ve Meta'ya aktarılmasından Meta ile birlikte sorumluyuz.</li><!--/lmp:meta--><!--lmp:google--><li><strong>Google:</strong> Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, İrlanda; ana şirketi Google LLC, ABD. Amaç: istatistik ve reklam ölçümü, yalnızca açık rızanla.</li><!--/lmp:google--><li><strong>Yetkili kamu kurum ve kuruluşları ile mahkemeler:</strong> kanunen yükümlü olduğumuz hâllerde.</li></ul><h3>Türkiye dışında işleme</h3><p>Veri sorumlusu Almanya'da yerleşik olduğundan kişisel verilerin Türkiye dışında, Avrupa Birliği'nde işlenir. Yukarıdaki hizmet sağlayıcılar AB'de kuruludur ve AB Genel Veri Koruma Tüzüğü'ne tabidir; veri işleyenler verileri yazılı veri işleme sözleşmelerine dayanarak işler.<!--lmp:meta--> Meta, verileri ABD'deki ana şirketi Meta Platforms, Inc.'e de aktarabilir; bu şirket AB-ABD Veri Gizliliği Çerçevesi kapsamında sertifikalıdır.<!--/lmp:meta--><!--lmp:google--> Google, verileri ABD'deki ana şirketi Google LLC'ye de aktarabilir; bu şirket AB-ABD Veri Gizliliği Çerçevesi kapsamında sertifikalıdır.<!--/lmp:google--></p><h2>4. Saklama süreleri</h2><ul><li>Sunucu kayıtları kısa bir süre sonra otomatik olarak silinir.</li><li>E-posta adresini bültenden çıkana kadar saklarız. Çıktıktan sonra, sana yeniden e-posta gönderilmemesi için adresin bir engelleme listesinde tutulabilir.</li><li>Onay kayıtlarını, mevzuatta öngörülen süre boyunca ve olası hukuki taleplerin zamanaşımı süresince (genellikle onayın sona ermesinden itibaren üç yıl) saklarız.</li><li>E-posta yazışmalarını, yasal saklama yükümlülükleri saklı kalmak kaydıyla talebin sonuçlanana kadar saklarız.</li><!--lmp:tracking--><li>Çerez tercihin (<code>lmp_consent</code>) tarayıcında 12 ay saklanır.</li><!--/lmp:tracking--><!--lmp:meta--><li>Meta çerezleri (<code>_fbp</code>, <code>_fbc</code>) tarayıcında 3 ay saklanır.</li><!--/lmp:meta--></ul><p>Süreler sona erdiğinde veya işleme amacı ortadan kalktığında kişisel verilerin silinir, yok edilir veya anonim hâle getirilir.</p><h2>5. Onayının ve açık rızanın geri alınması</h2><p>Ticari elektronik ileti onayını istediğin zaman, gerekçe göstermeden ve ücretsiz olarak geri alabilirsin: her e-postadaki abonelikten çıkma bağlantısıyla veya <a href=\"mailto:{{lmp:email}}\">{{lmp:email}}</a> adresine yazarak. Ret bildirimin en geç üç iş günü içinde işleme alınır.<!--lmp:tracking--> Çerezler için verdiğin açık rızayı sayfanın altındaki <strong>Çerez ayarları</strong> bağlantısından geri alabilirsin.<!--/lmp:tracking--> Geri alma, o ana kadar yapılan işlemenin hukuka uygunluğunu etkilemez.</p><h2>6. KVKK'nın 11. maddesi kapsamındaki hakların</h2><p>Veri sorumlusuna başvurarak şu haklarını kullanabilirsin:</p><ul><li>kişisel verilerinin işlenip işlenmediğini öğrenme,</li><li>kişisel verilerin işlenmişse buna ilişkin bilgi talep etme,</li><li>kişisel verilerinin işlenme amacını ve bunların amacına uygun kullanılıp kullanılmadığını öğrenme,</li><li>yurt içinde veya yurt dışında kişisel verilerinin aktarıldığı üçüncü kişileri bilme,</li><li>kişisel verilerinin eksik veya yanlış işlenmiş olması hâlinde bunların düzeltilmesini isteme,</li><li>KVKK'nın 7. maddesinde öngörülen şartlar çerçevesinde kişisel verilerinin silinmesini veya yok edilmesini isteme,</li><li>düzeltme, silme veya yok etme işlemlerinin kişisel verilerinin aktarıldığı üçüncü kişilere bildirilmesini isteme,</li><li>işlenen verilerin münhasıran otomatik sistemler vasıtasıyla analiz edilmesi suretiyle aleyhine bir sonucun ortaya çıkmasına itiraz etme,</li><li>kişisel verilerinin kanuna aykırı olarak işlenmesi sebebiyle zarara uğraman hâlinde zararın giderilmesini talep etme.</li></ul><p>Münhasıran otomatik sistemlerle senin aleyhine sonuç doğuran kararlar almıyoruz.</p><h2>7. Başvuru yöntemi</h2><p>Haklarını kullanmak için başvurunu Türkçe olarak şu yollardan biriyle iletebilirsin:</p><ul><li>bize daha önce bildirdiğin ve sistemimizde kayıtlı olan e-posta adresinden (ör. bültene kayıtlı adresin) <a href=\"mailto:{{lmp:email}}\">{{lmp:email}}</a> adresine e-posta göndererek,</li><li>ıslak imzalı yazılı bir dilekçeyle yukarıdaki posta adresine göndererek.</li></ul><p>Başvurunda adın ve soyadın, yazılı başvurularda imzan, Türk vatandaşıysan T.C. kimlik numaran (yabancıysan uyruğun ve pasaport ya da varsa kimlik numaran), tebligata esas yerleşim yeri veya iş yeri adresin ve talep konun bulunmalıdır; varsa bildirime esas e-posta adresini ve telefon numaranı da ekleyebilirsin (Veri Sorumlusuna Başvuru Usul ve Esasları Hakkında Tebliğ).</p><p>Başvurunu niteliğine göre en kısa sürede ve en geç 30 gün içinde ücretsiz olarak sonuçlandırırız. İşlemin ayrıca bir maliyet gerektirmesi hâlinde Kişisel Verileri Koruma Kurulu'nun belirlediği tarifedeki ücret alınabilir. Başvurunun reddedilmesi, verilen cevabı yetersiz bulman veya süresinde cevap verilmemesi hâlinde, cevabı öğrendiğin tarihten itibaren 30 gün ve her hâlde başvuru tarihinden itibaren 60 gün içinde Kişisel Verileri Koruma Kurulu'na şikâyette bulunabilirsin (KVKK md. 14).</p><h2>8. Değişiklikler</h2><p>Veri işleme faaliyetlerimiz değişirse bu metni güncelleriz. Her zaman bu sayfadaki güncel sürüm geçerlidir.</p><p class=\"lmp-updated\">Son güncelleme: 14 Ekim 2026</p>","text_color":"#414B46","__globals__":{"text_color":"globals/colors?id=lmptext","typography_typography":"globals/typography?id=lmpbody"},"_css_classes":"lmp-prose"},"elements":[]}],"isInner":false},{"id":"def8538","elType":"container","settings":{"content_width":"boxed","flex_direction":"column","boxed_width":{"unit":"px","size":1180,"sizes":[]},"flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px"},"html_tag":"footer","padding":{"unit":"px","top":"48","right":"32","bottom":"48","left":"32","isLinked":false},"padding_tablet":{"unit":"px","top":"48","right":"32","bottom":"48","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"40","right":"16","bottom":"40","left":"16","isLinked":false},"border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E3E2DB","css_classes":"e-no-lazyload"},"elements":[{"id":"e36bb0e","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_wrap":"wrap","flex_gap":{"column":"24","row":"24","isLinked":true,"unit":"px"},"flex_align_items":"center","flex_justify_content":"space-between","flex_direction_mobile":"column","flex_align_items_mobile":"flex-start"},"elements":[{"id":"ecb85f5","elType":"widget","widgetType":"heading","settings":{"title":"LEAN MODE <span class=\"lmp-pro\">PRO</span>","header_size":"p","link":{"url":"/","is_external":"","nofollow":"","custom_attributes":""},"title_color":"#101614","_css_classes":"lmp-logo","__globals__":{"title_color":"globals/colors?id=lmpink"},"typography_typography":"custom","typography_font_family":"Instrument Sans","typography_font_size":{"unit":"px","size":15,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":14,"sizes":[]},"typography_font_weight":"700","typography_line_height":{"unit":"em","size":1,"sizes":[]},"typography_letter_spacing":{"unit":"em","size":0.14,"sizes":[]},"typography_letter_spacing_mobile":{"unit":"em","size":0.1,"sizes":[]}},"elements":[]},{"id":"82460cf","elType":"widget","widgetType":"icon-list","settings":{"view":"inline","icon_list":[{"_id":"1a702b7","text":"Gizlilik Politikası","selected_icon":{"value":"","library":""},"link":{"url":"/gizlilik-politikasi/","is_external":"","nofollow":"","custom_attributes":""}},{"_id":"72ac789","text":"KVKK Aydınlatma Metni","selected_icon":{"value":"","library":""},"link":{"url":"/kvkk-aydinlatma-metni/","is_external":"","nofollow":"","custom_attributes":""}},{"_id":"60c3013","text":"Çerez Politikası","selected_icon":{"value":"","library":""},"link":{"url":"/cerez-politikasi/","is_external":"","nofollow":"","custom_attributes":""}},{"_id":"0918f27","text":"Yasal Bilgiler","selected_icon":{"value":"","library":""},"link":{"url":"/yasal-bilgiler/","is_external":"","nofollow":"","custom_attributes":""}},{"_id":"559dadc","text":"Çerez ayarları","selected_icon":{"value":"","library":""},"link":{"url":"#cerez-ayarlari","is_external":"","nofollow":"","custom_attributes":""}}],"space_between":{"unit":"px","size":28,"sizes":[]},"icon_size":{"unit":"px","size":14,"sizes":[]},"text_indent":{"unit":"px","size":8,"sizes":[]},"icon_color":"#1D5A48","text_color":"#5D6762","__globals__":{"icon_color":"globals/colors?id=lmpaccent","text_color":"globals/colors?id=lmpmuted"},"icon_typography_typography":"custom","icon_typography_font_family":"Instrument Sans","icon_typography_font_size":{"unit":"px","size":14,"sizes":[]},"icon_typography_font_weight":"500","icon_typography_line_height":{"unit":"em","size":1.5,"sizes":[]},"text_color_hover":"#101614"},"elements":[]}],"isInner":true},{"id":"34dcf48","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>© 2026 Lean Mode Pro. Tüm hakları saklıdır.</p>","text_color":"#414B46","__globals__":{"text_color":"globals/colors?id=lmpmuted","typography_typography":"globals/typography?id=lmpsmall"},"_margin":{"unit":"px","top":"32","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[]}],"isInner":false}]