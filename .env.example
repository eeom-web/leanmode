# --- E-posta kayıt formu / Email signup form -------------------------------
# URL of the backend endpoint that receives signups (POST, JSON: { email, source }).
# Leave empty to run the form in demo mode (no data is sent anywhere).
# Example: https://leanmodepro.com/api/subscribe
PUBLIC_SIGNUP_ENDPOINT=

# Optional: redirect here after a successful signup (e.g. a thank-you page).
# Leave empty to show the success message inline.
PUBLIC_SIGNUP_SUCCESS_URL=
