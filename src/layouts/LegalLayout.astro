---
/**
 * Placeholder layout for legal pages. The actual legal texts are not written
 * yet — add them here once they are provided, then remove `noindex`.
 */
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={`${site.name} — ${title}`}
  noindex
  headerCtaHref={`/${site.signupAnchor}`}
>
  <article class="legal container">
    <a class="legal__back" href="/">← Ana sayfaya dön</a>
    <h1>{title}</h1>
    <slot>
      <p class="legal__placeholder">Bu sayfanın içeriği hazırlanmaktadır.</p>
    </slot>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: calc(46rem + var(--gutter) * 2);
    min-height: 55vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .legal__back {
    color: var(--muted);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .legal__back:hover {
    color: var(--ink);
  }

  .legal h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 3vw + 1.25rem, 3.25rem);
  }

  .legal__placeholder {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
  }
</style>
