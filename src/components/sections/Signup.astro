---
import Icon, { type IconName } from '../Icon.astro';
import SignupForm from '../SignupForm.astro';

const includes: { icon: IconName; label: string }[] = [
  { icon: 'nutrition', label: 'Beslenme' },
  { icon: 'training', label: 'Antrenman' },
  { icon: 'movement', label: 'Günlük hareket' },
  { icon: 'habits', label: 'Alışkanlıklar' },
];
---

<section id="kayit" class="signup-section" aria-labelledby="kayit-title">
  <div class="container">
    <div class="card signup-card">
      <div class="signup-card__intro">
        <p class="eyebrow">Ücretsiz rehber</p>
        <h2 id="kayit-title" class="signup-card__title">30 Günlük Planını Ücretsiz Al</h2>
        <ul class="signup-card__includes" role="list" aria-label="Planın içeriği">
          {
            includes.map((item) => (
              <li>
                <Icon name={item.icon} size={18} />
                {item.label}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="signup-card__form">
        <SignupForm id="kayit-form" source="hero" />
      </div>
    </div>
  </div>
</section>

<style>
  .signup-card {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .signup-card__intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .signup-card__title {
    font-size: clamp(1.75rem, 2vw + 1.1rem, 2.375rem);
  }

  .signup-card__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .signup-card__includes li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--ink-soft);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .signup-card__includes svg {
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .signup-card {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 3.5rem;
    }
  }
</style>
