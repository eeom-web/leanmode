---
import Icon from '../Icon.astro';

const groups = [
  'Yeni başlayanlar',
  'Daha düzenli beslenmek isteyenler',
  'Hareket ve antrenmanı rutinine eklemek isteyenler',
  'Kilo verme sürecini daha basit hale getirmek isteyenler',
];
---

<section class="section audience" aria-labelledby="kimler-title">
  <div class="container audience__grid">
    <header class="section-head audience__head">
      <p class="eyebrow">Kimler için?</p>
      <h2 id="kimler-title" class="h2">Bu Plan Kimler İçin?</h2>
      <p>
        Kilo vermek isteyen, nereden başlayacağını bilmeyen veya başladığı planları sürdürme
        konusunda zorlanan kişiler için tasarlanmıştır.
      </p>
    </header>

    <ul class="audience__cards" role="list">
      {
        groups.map((group) => (
          <li class="card audience__card">
            <span class="audience__check">
              <Icon name="check" size={18} strokeWidth={2.2} />
            </span>
            <h3>{group}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .audience__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .audience__cards {
    display: grid;
    gap: 1rem;
  }

  .audience__card {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    min-height: 11rem;
    padding: 1.75rem;
  }

  .audience__check {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
  }

  .audience__card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  @media (max-width: 639px) {
    .audience__card {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1rem;
      min-height: 0;
      padding: 1.25rem 1.375rem;
    }

    .audience__card h3 {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 640px) {
    .audience__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .audience__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .audience__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .audience__cards {
      gap: 1.25rem;
    }
  }
</style>
